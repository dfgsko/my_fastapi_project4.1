# Скопируйте в .env:  cp .env.example .env   (.env не коммитить!)
# В Kubernetes эти переменные разделены на ConfigMap (хосты, имена)
# и Secret (логины/пароли) — см. k8s/01-configmap.yaml, k8s/02-secrets.yaml.

# --- PostgreSQL --------------------------------------------------------
# Вариант 1: готовая строка (приоритетнее). Драйвер — asyncpg.
DATABASE_URL=postgresql+asyncpg://appuser:apppass@localhost:5432/appdb
# Вариант 2: по частям (так работает Kubernetes)
# DATABASE_HOST=postgres
# DATABASE_NAME=appdb
# DATABASE_USER=appuser
# DATABASE_PASSWORD=apppass

# Локально без PostgreSQL можно использовать SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./app.db

# --- Redis (кэш, rate limiting, backend результатов Celery) ------------
REDIS_URL=redis://localhost:6379/0

# --- RabbitMQ (брокер Celery) ------------------------------------------
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//

# --- Прочее --------------------------------------------------------------
# Создавать таблицы при старте (в k8s false — схему применяет alembic).
AUTO_CREATE_TABLES=true
CERTIFICATES_DIR=certificates
# Искусственная задержка задачи (сек) — только для демонстрации KEDA.
CERTIFICATE_DELAY_SECONDS=0

# --- S3-хранилище SeaweedFS (лаб. № 4) ---------------------------------
# Compose: http://seaweedfs:8333 ; Kubernetes: http://seaweedfs-s3:8333
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=fastapi-files
S3_REGION=us-east-1
# admin — загрузка/удаление; reader — скачивание (если не заданы, всё идёт под admin)
S3_ACCESS_KEY=app-admin-key
S3_SECRET_KEY=app-admin-secret-change-me
S3_READ_ACCESS_KEY=app-reader-key
S3_READ_SECRET_KEY=app-reader-secret-change-me
S3_MAX_UPLOAD_BYTES=10485760
# Воркер кладёт готовые сертификаты в бакет (certificates/)
S3_UPLOAD_CERTIFICATES=false

# --- Метрики Prometheus (лаб. № 4) -------------------------------------
METRICS_ENABLED=true
# Публиковать длину очереди Celery (celery_queue_length) на /metrics
CELERY_QUEUE_METRICS=true
