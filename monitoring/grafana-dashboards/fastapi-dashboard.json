    {
      "id": 18,
      "type": "logs",
      "title": "Ошибки и предупреждения",
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "{namespace=~\"fastapi-.*\", app=\"fastapi\"} |~ \"(?i)error|exception|traceback|warning\"",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    },
